rules_version = '2';
// Firestore security rules for the diankanacloud Firebase project.
// Anyone can read comments; only users signed in with Google can post,
// and the name on a comment must be their Google account name;
// authors can delete their own comments; nobody can edit.
// Contact messages: anyone can send one; nobody can read, edit or delete
// them from the website (read them in the Firebase console).
service cloud.firestore {
  match /databases/{database}/documents {
    match /comments/{commentId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.resource.data.keys().hasOnly(['articleId','parentId','text','uid','name','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.articleId is string
        && request.resource.data.articleId.size() > 0
        && request.resource.data.articleId.size() <= 100
        && (request.resource.data.parentId == null || request.resource.data.parentId is string)
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 200
        && request.resource.data.name == request.auth.token.get('name', '')
        && request.resource.data.createdAt == request.time;

      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    match /messages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly(['name','email','message','lang','createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 200
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && request.resource.data.lang in ['fr', 'en']
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
